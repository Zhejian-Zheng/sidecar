# Sidecar 环境变量示例。复制为 .env 后填写；真实密钥不要提交 Git。
# 项目不会自动加载 .env，需自行 export 或用工具加载后再启动。

# 模型（OpenAI 兼容端点，如 DeepSeek）
SIDECAR_MODEL=deepseek-flash
SIDECAR_BASE_URL=https://api.deepseek.com
SIDECAR_API_KEY=

# 固定配对令牌：设置后网页与 OpenAI 兼容接口共用此 key，跨目录、跨启动不变
SIDECAR_PAIRING_TOKEN=

# Dify 知识库（可选；MCP 接入尚未实现）
DIFY_API_BASE_URL=
DIFY_KNOWLEDGE_API_KEY=
DIFY_DATASET_ID=
